# Copy to .env and fill in.
# .env is gitignored — never commit it.

# Bearer token required on the streamable-HTTP MCP transport (POST/GET /mcp).
# Leave empty to disable auth (only safe for localhost-bound deployments).
# Generate a strong token, e.g.:
#   openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
#   # or, on Windows PowerShell:
#   #   $b=New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b).TrimEnd('=').Replace('+','-').Replace('/','_')
MCP_AUTH_TOKEN=
